# 必须使用至少 32 字节的随机密钥，例如：openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-bytes

# LOGIN_PASSWORD 与企业微信认证至少配置一种
LOGIN_PASSWORD=replace-with-a-strong-shared-password

# 企业微信认证（可选）
# WECORP_ID=ww1234567890
# WECORP_SECRET=replace-with-wecom-secret
# WECORP_AGENT_ID=1000002
# APP_BASE_URL=https://inventory.example.com/inventory

# 跨域和 Host 白名单（生产部署按实际域名填写）
# CORS_ORIGINS=https://inventory.example.com
# ALLOWED_HOSTS=inventory.example.com
